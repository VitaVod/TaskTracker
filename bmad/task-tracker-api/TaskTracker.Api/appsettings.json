{
  "ConnectionStrings": {
    "TaskTrackerDb": "Server=(localdb)\\mssqllocaldb;Database=TaskTrackerDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "task-tracker-api",
    "Audience": "task-tracker-web",
    "SigningKey": "CHANGE_THIS_FOR_PROD_TO_A_VERY_LONG_RANDOM_SECRET_KEY_123456789",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "PasswordRecovery": {
    "FrontendBaseUrl": "http://localhost:4200",
    "ResetPath": "/reset-password"
  },
  "SharedViewCache": {
    "KeyPrefix": "tasktracker:shared-views",
    "LeaderboardTtlSeconds": 120,
    "GlobalStatisticsTtlSeconds": 120,
    "FreshnessWindowSeconds": 30,
    "DuplicateInvalidationSuppressionSeconds": 30,
    "GenerationTtlHours": 24
  },
  "ProgressionLevels": {
    "BaseXpPerLevel": 100,
    "GrowthXpPerLevel": 25,
    "StartingLevel": 1,
    "BandMilestoneLevels": [3, 5, 10, 20, 30, 50]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
